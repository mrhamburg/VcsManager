<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>VcsManager.AzureDevOps</PackageId>
    <Description>Azure DevOps provider for VcsManager</Description>
    <Authors>mrhamburg</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>vcs;git;azure-devops;dotnet</PackageTags>
    <RepositoryUrl>https://github.com/mrhamburg/VcsManager</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.TeamFoundationServer.Client" Version="20.256.2" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.13" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VcsManager\VcsManager.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VcsManager.AzureDevOps.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
