<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>VcsManager.Gitea</PackageId>
    <Description>Gitea provider for VcsManager</Description>
    <Authors>mrhamburg</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>vcs;git;gitea;dotnet</PackageTags>
    <RepositoryUrl>https://github.com/mrhamburg/VcsManager</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VcsManager\VcsManager.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VcsManager.Gitea.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
