<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>VcsManager.Core</PackageId>
    <Description>Core abstraction library for unified version control management across multiple providers</Description>
    <PackageTags>vcs;git;github;gitlab;azure-devops;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VcsManager.GitHub" />
    <InternalsVisibleTo Include="VcsManager.GitLab" />
    <InternalsVisibleTo Include="VcsManager.Gitea" />
    <InternalsVisibleTo Include="VcsManager.AzureDevOps" />
    <InternalsVisibleTo Include="VcsManager.Tests" />
  </ItemGroup>

</Project>
