<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>VcsManager.Core</PackageId>
    <Description>Core abstraction library for unified version control management across multiple providers</Description>
    <Authors>mrhamburg</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>vcs;git;github;gitlab;azure-devops;dotnet</PackageTags>
    <RepositoryUrl>https://github.com/mrhamburg/VcsManager</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
